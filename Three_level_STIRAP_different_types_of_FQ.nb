           RowBox[{"\[HBar]", "/", "2"}], ")"}], "*", 
          RowBox[{"Evaluate", "[", 
           RowBox[{
            RowBox[{"\[CapitalOmega]pFQ2", "[", "t", "]"}], "/.", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Part", "[", 
