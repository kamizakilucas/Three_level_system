Cell[TextData[{
 "Figures for the population transfer from the state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|1", "\[RightAngleBracket]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$|1 \\rangle$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e2780038-f76f-4bb1-9338-5359c2cb0b38"],
 " to  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|3", "\[RightAngleBracket]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$|3 \\rangle$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4546bb28-3e4b-44c8-85cf-217f3e91ac95"],
 " at the end of the protocol for protocols of different durations; the \
time-averaged excess work; and the cost of Santos and Sarandy for the minimal \
action protocol.   "
}], "Text",
 CellChangeTimes->{{3.983017972834923*^9, 3.983017989425477*^9}, {
  3.9830186051133337`*^9, 
  3.98301860535021*^9}},ExpressionUUID->"ae3479f6-60a7-4e4f-bc6f-\
5415f5ea2026"],

