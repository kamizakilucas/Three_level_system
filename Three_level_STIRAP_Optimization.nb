           RowBox[{
            RowBox[{"{", 
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<\!\(\*SubscriptBox[\(\[CapitalOmega]\), \
\(p\)]\)(t) - OP\>\"", ",", "10"}], "]"}], "}"}], ",", 
            RowBox[{"LegendLayout", "\[Rule]", "\"\<Row\>\""}]}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"Left", ",", "0.94"}], "}"}]}], "]"}]}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
