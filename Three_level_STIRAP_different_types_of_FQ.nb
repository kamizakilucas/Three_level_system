          RowBox[{"+", 
           RowBox[{"(", 
            RowBox[{"\[HBar]", "/", "2"}], ")"}]}], "*", 
          RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "*", 
          RowBox[{"c2FQ2", "[", "t", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"c1FQ2", "[", "ti", "]"}], "==", "c10"}], ",", 
        RowBox[{
         RowBox[{"c2FQ2", "[", "ti", "]"}], "==", "c20"}], ",", 
        RowBox[{
         RowBox[{"c3FQ2", "[", "ti", "]"}], "==", "c30"}]}], " ", "}"}], ",", 
      
      RowBox[{"{", 
       RowBox[{"c1FQ2", ",", "c2FQ2", ",", "c3FQ2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "ti", ",", "tf"}], "}"}]}], "]"}], ",", 
