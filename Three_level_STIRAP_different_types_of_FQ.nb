                 "\[CapitalDelta]T"}], " ", "+", " ", "1"}]}], "]"}], "]"}], ",",
             "1"}], "]"}]}], "]"}], "^", "2"}], "/.", 
       RowBox[{"t", "->", "tf"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"tf", ",", "Tmin", ",", "Tmax", ",", "\[CapitalDelta]T"}], 
