Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Protocol", " ", "time", " ", "for", " ", "the", " ", "Figure"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"n", " ", "=", " ", "1"}], "\[IndentingNewLine]", 
   RowBox[{"tf", " ", "=", " ", 
    RowBox[{"Tmin", " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"n", "-", "1"}], ")"}], "*", "\[CapitalDelta]T"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"\[CapitalOmega]pOP", "[", "t", "]"}], "/.", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Part", "[", 
           RowBox[{"ProtOP", ",", " ", "n"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "ti", ",", " ", 
