Cell["\<\
Solution of the Schr\[ODoubleDot]dinger equation for the fast quasidiabatic \
protocol.\
\>", "Text",
 CellChangeTimes->{{3.983019311912407*^9, 
  3.983019350699664*^9}},ExpressionUUID->"82f11900-a4f0-440b-ac29-\
a63794872685"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SolFQ", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"\[ImaginaryI]", "*", "\[HBar]", "*", 
          RowBox[{
           RowBox[{"c1FQ", "'"}], "[", "t", "]"}]}], " ", "==", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[HBar]", "/", "2"}], ")"}], "*", 
          RowBox[{"Evaluate", "[", 
           RowBox[{
            RowBox[{"\[CapitalOmega]pFQ", "[", "t", "]"}], "/.", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Part", "[", 
              RowBox[{"ProtFQ", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"tf", "-", "Tmin"}], ")"}], "/", 
                 "\[CapitalDelta]T"}], " ", "+", " ", "1"}]}], "]"}], "]"}]}],
            "]"}], "*", 
          RowBox[{"c2FQ", "[", "t", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", "*", "\[HBar]", "*", 
          RowBox[{
           RowBox[{"c2FQ", "'"}], "[", "t", "]"}]}], " ", "==", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[HBar]", "/", "2"}], ")"}], "*", 
           RowBox[{"Evaluate", "[", 
            RowBox[{
             RowBox[{"\[CapitalOmega]pFQ", "[", "t", "]"}], "/.", 
             RowBox[{"Flatten", "[", 
              RowBox[{"Part", "[", 
               RowBox[{"ProtFQ", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"tf", "-", "Tmin"}], ")"}], "/", 
                  "\[CapitalDelta]T"}], " ", "+", " ", "1"}]}], "]"}], 
              "]"}]}], "]"}], "*", 
           RowBox[{"c1FQ", "[", "t", "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", "\[HBar]", ")"}], "*", "\[CapitalDelta]", "*", 
           RowBox[{"c2FQ", "[", "t", "]"}]}], "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[HBar]", "/", "2"}], ")"}], "*", 
           RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "*", 
           RowBox[{"c3FQ", "[", "t", "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", "*", "\[HBar]", "*", 
          RowBox[{
           RowBox[{"c3FQ", "'"}], "[", "t", "]"}]}], " ", "==", 
         RowBox[{
          RowBox[{"+", 
           RowBox[{"(", 
            RowBox[{"\[HBar]", "/", "2"}], ")"}]}], "*", 
          RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "*", 
          RowBox[{"c2FQ", "[", "t", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"c1FQ", "[", "ti", "]"}], "==", "c10"}], ",", 
        RowBox[{
         RowBox[{"c2FQ", "[", "ti", "]"}], "==", "c20"}], ",", 
        RowBox[{
         RowBox[{"c3FQ", "[", "ti", "]"}], "==", "c30"}]}], " ", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"c1FQ", ",", "c2FQ", ",", "c3FQ"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "ti", ",", "tf"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "tf", ",", "Tmin", ",", " ", "Tmax", ",", " ", "\[CapitalDelta]T"}], 
     "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9826695608196907`*^9, 3.982669609520351*^9}, {
