Cell["Minimal action", "Section",
 CellChangeTimes->{{3.9826677043305807`*^9, 
  3.982667707706952*^9}},ExpressionUUID->"608932e2-59cb-4744-b923-\
132852b91d33"],

Cell["\<\
The protocols of the minimal action (MA) method comes from the minimization \
of the adiabatic action. \
\>", "Text",
 CellChangeTimes->{{3.983016763802003*^9, 
  3.9830168148979053`*^9}},ExpressionUUID->"a857498d-4c20-4ac0-8b3b-\
b5f40c544392"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Transitions", " ", "between", " ", "n"}], "-", " ", 
    RowBox[{"and", " ", "n0"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ProtMA", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"\[CapitalOmega]pMA", "'"}], "[", "t", "]"}], "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"\[CapitalOmega]pMA", "[", "t", "]"}], "^", "2"}], 
                 " ", "+", " ", 
                 RowBox[{
                  RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "^", "2"}]}], 
                ")"}]}], ",", "t"}], "]"}], " ", "+", " ", 
            RowBox[{"4", "*", 
             RowBox[{"\[CapitalDelta]", "/", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"\[CapitalOmega]pMA", "[", "t", "]"}], "^", "2"}], 
                 " ", "+", " ", 
                 RowBox[{
                  RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "^", "2"}]}], 
                ")"}], "^", 
               RowBox[{"(", 
                RowBox[{"3", "/", "2"}], ")"}]}]}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"\[CapitalOmega]pMA", "''"}], "[", "t", "]"}], " ", "-",
                " ", 
               RowBox[{"2.5", "*", 
                RowBox[{"\[CapitalOmega]pMA", "[", "t", "]"}], "*", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"\[CapitalOmega]pMA", "'"}], "[", "t", "]"}], "^", 
                  "2"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"\[CapitalOmega]pMA", "[", "t", "]"}], "^", "2"}],
                    " ", "+", " ", 
                   RowBox[{
                    RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "^", "2"}]}],
                   ")"}]}]}]}], ")"}]}]}], " ", "==", "0"}], " ", ",", " ", 
          RowBox[{
           RowBox[{"\[CapitalOmega]pMA", "[", "ti", "]"}], "==", 
           "\[CapitalOmega]pi"}], ",", " ", 
          RowBox[{
           RowBox[{"\[CapitalOmega]pMA", "[", "tf", "]"}], "==", 
           "\[CapitalOmega]pf"}]}], "}"}], ",", "\[CapitalOmega]pMA", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "ti", ",", "tf"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"tf", ",", "Tmin", ",", "Tmax", ",", "\[CapitalDelta]T"}], 
       "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Transitions", " ", "between", " ", "n"}], "-", " ", 
     RowBox[{"and", " ", "n"}], "+"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ProtMA3", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"\[CapitalOmega]pMA3", "'"}], "[", "t", "]"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[CapitalOmega]pMA3", "[", "t", "]"}], "^", "2"}], 
                " ", "+", " ", 
                RowBox[{
                 RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "^", "2"}]}], 
               ")"}]}], ",", "t"}], "]"}], " ", "==", "0"}], " ", ",", " ", 
          RowBox[{
           RowBox[{"\[CapitalOmega]pMA3", "[", "ti", "]"}], "==", 
           "\[CapitalOmega]pi"}], ",", " ", 
          RowBox[{
           RowBox[{"\[CapitalOmega]pMA3", "[", "tf", "]"}], "==", 
           "\[CapitalOmega]pf"}]}], "}"}], ",", "\[CapitalOmega]pMA3", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "ti", ",", "tf"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"tf", ",", "Tmin", ",", "Tmax", ",", "\[CapitalDelta]T"}], 
       "}"}]}], "]"}]}]}]}]], "Input",
