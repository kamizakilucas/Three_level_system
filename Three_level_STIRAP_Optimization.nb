Cell["\<\
Solution of the Schr\[ODoubleDot]dinger equation for a system under the \
physical unitary transformation method. \
\>", "Text",
 CellChangeTimes->{
  3.983017943285302*^9},ExpressionUUID->"123ef0c4-eb41-494b-a6de-\
3fa3a57e6f77"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SolMA", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"\[ImaginaryI]", "*", "\[HBar]", "*", 
          RowBox[{
           RowBox[{"c1MA", "'"}], "[", "t", "]"}]}], " ", "==", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[HBar]", "/", "2"}], ")"}], "*", 
          RowBox[{"Evaluate", "[", 
           RowBox[{
            RowBox[{"\[CapitalOmega]pMA", "[", "t", "]"}], "/.", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Part", "[", 
              RowBox[{"ProtMA", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"tf", "-", "Tmin"}], ")"}], "/", 
                 "\[CapitalDelta]T"}], " ", "+", " ", "1"}]}], "]"}], "]"}]}],
            "]"}], "*", 
          RowBox[{"c2MA", "[", "t", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", "*", "\[HBar]", "*", 
          RowBox[{
           RowBox[{"c2MA", "'"}], "[", "t", "]"}]}], " ", "==", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[HBar]", "/", "2"}], ")"}], "*", 
           RowBox[{"Evaluate", "[", 
            RowBox[{
             RowBox[{"\[CapitalOmega]pMA", "[", "t", "]"}], "/.", 
             RowBox[{"Flatten", "[", 
              RowBox[{"Part", "[", 
               RowBox[{"ProtMA", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"tf", "-", "Tmin"}], ")"}], "/", 
                  "\[CapitalDelta]T"}], " ", "+", " ", "1"}]}], "]"}], 
              "]"}]}], "]"}], "*", 
           RowBox[{"c1MA", "[", "t", "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", "\[HBar]", ")"}], "*", "\[CapitalDelta]", "*", 
           RowBox[{"c2MA", "[", "t", "]"}]}], "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[HBar]", "/", "2"}], ")"}], "*", 
           RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "*", 
           RowBox[{"c3MA", "[", "t", "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", "*", "\[HBar]", "*", 
          RowBox[{
           RowBox[{"c3MA", "'"}], "[", "t", "]"}]}], " ", "==", 
         RowBox[{
          RowBox[{"+", 
           RowBox[{"(", 
            RowBox[{"\[HBar]", "/", "2"}], ")"}]}], "*", 
          RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "*", 
          RowBox[{"c2MA", "[", "t", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"c1MA", "[", "ti", "]"}], "==", "c10"}], ",", 
        RowBox[{
         RowBox[{"c2MA", "[", "ti", "]"}], "==", "c20"}], ",", 
        RowBox[{
         RowBox[{"c3MA", "[", "ti", "]"}], "==", "c30"}]}], " ", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"c1MA", ",", "c2MA", ",", "c3MA"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "ti", ",", "tf"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "tf", ",", "Tmin", ",", " ", "Tmax", ",", " ", "\[CapitalDelta]T"}], 
     "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.982668620168417*^9, 3.982668664102387*^9}, {
  3.982668699372473*^9, 3.982668788040071*^9}, {3.982936873885415*^9, 
