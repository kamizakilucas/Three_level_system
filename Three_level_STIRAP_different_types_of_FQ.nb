Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Protocol", " ", "time", " ", "for", " ", "the", " ", "Figure"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"n", " ", "=", " ", "10"}], "\[IndentingNewLine]", 
   RowBox[{"tf", " ", "=", " ", 
    RowBox[{"Tmin", " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"n", "-", "1"}], ")"}], "*", "\[CapitalDelta]T"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"\[CapitalOmega]pFQ", "[", "t", "]"}], "/.", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Part", "[", 
           RowBox[{"ProtFQ", ",", " ", "n"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "ti", ",", "tf"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotTheme", "->", " ", "\"\<Detailed\>\""}], ",", 
       RowBox[{"PlotStyle", "->", " ", 
        RowBox[{"{", "Black", "}"}]}], ",", 
       RowBox[{"FrameLabel", " ", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<t / \[Tau]\>\"", ",", " ", "\"\<Protocol\>\""}], 
         "}"}]}], ",", 
       RowBox[{"LabelStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directive", "[", " ", "11", "]"}], ",", " ", 
          RowBox[{"FontFamily", "->", " ", "\"\<Arial\>\""}], ",", " ", 
          "Black"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"LineLegend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<\!\(\*SubscriptBox[\(\[CapitalOmega]\), \
\(p\)]\)(t) - FQ1\>\"", ",", "10"}], "]"}], "}"}], ",", 
            RowBox[{"LegendLayout", "\[Rule]", "\"\<Row\>\""}]}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"Left", ",", "0.94"}], "}"}]}], "]"}]}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "ti", ",", "tf"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotTheme", "->", " ", "\"\<Detailed\>\""}], ",", 
       RowBox[{"PlotStyle", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Red", ",", " ", 
          RowBox[{"Dashing", "[", "0.01", "]"}]}], "}"}]}], ",", 
       RowBox[{"FrameLabel", " ", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<t / \[Tau]\>\"", ",", 
          " ", "\"\<\!\(\*SubscriptBox[\(\[CapitalOmega]\), \(s\)]\)\>\""}], 
         "}"}]}], ",", 
       RowBox[{"LabelStyle", " ", "->", " ", 
