Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Protocol", " ", "time", " ", "for", " ", "the", " ", "Figure"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"n", " ", "=", " ", "1"}], "\[IndentingNewLine]", 
   RowBox[{"tf", " ", "=", " ", 
    RowBox[{"Tmin", " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"n", "-", "1"}], ")"}], "*", "\[CapitalDelta]T"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"\[CapitalOmega]pFQ", "[", "t", "]"}], "/.", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Part", "[", 
           RowBox[{"ProtFQ", ",", " ", "n"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "ti", ",", "tf"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotTheme", "->", " ", "\"\<Detailed\>\""}], ",", 
       RowBox[{"PlotStyle", "->", " ", 
        RowBox[{"{", "Black", "}"}]}], ",", 
