Cell["Solution of the Schr\[ODoubleDot]dinger equation for the linear \
protocol", "Text",
 CellChangeTimes->{{3.982998455816568*^9, 
  3.982998527578753*^9}},ExpressionUUID->"9f8597f9-0802-488b-adfe-\
40963caedaec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sol", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"\[ImaginaryI]", "*", "\[HBar]", "*", 
          RowBox[{
           RowBox[{"c1", "'"}], "[", "t", "]"}]}], " ", "==", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[HBar]", "/", "2"}], ")"}], "*", 
          RowBox[{"\[CapitalOmega]p", "[", 
           RowBox[{"t", ",", "tf"}], "]"}], "*", 
          RowBox[{"c2", "[", "t", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", "*", "\[HBar]", "*", 
          RowBox[{
           RowBox[{"c2", "'"}], "[", "t", "]"}]}], " ", "==", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[HBar]", "/", "2"}], ")"}], "*", 
           RowBox[{"\[CapitalOmega]p", "[", 
            RowBox[{"t", ",", "tf"}], "]"}], "*", 
           RowBox[{"c1", "[", "t", "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", "\[HBar]", ")"}], "*", "\[CapitalDelta]", "*", 
           RowBox[{"c2", "[", "t", "]"}]}], "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[HBar]", "/", "2"}], ")"}], "*", 
           RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "*", 
           RowBox[{"c3", "[", "t", "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", "*", "\[HBar]", "*", 
          RowBox[{
           RowBox[{"c3", "'"}], "[", "t", "]"}]}], " ", "==", 
         RowBox[{
          RowBox[{"+", 
           RowBox[{"(", 
            RowBox[{"\[HBar]", "/", "2"}], ")"}]}], "*", 
          RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "*", 
          RowBox[{"c2", "[", "t", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"c1", "[", "ti", "]"}], "==", "c10"}], ",", 
        RowBox[{
         RowBox[{"c2", "[", "ti", "]"}], "==", "c20"}], ",", 
        RowBox[{
         RowBox[{"c3", "[", "ti", "]"}], "==", "c30"}]}], " ", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"c1", ",", "c2", ",", "c3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "ti", ",", "tf"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "tf", ",", "Tmin", ",", " ", "Tmax", ",", " ", "\[CapitalDelta]T"}], 
     "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.983860761519738*^9, 3.9838607742000723`*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"78511358-162a-46de-a3a6-c1ff1651206f"],

