         RowBox[{"c2FQ3", "[", "ti", "]"}], "==", "c20"}], ",", 
        RowBox[{
         RowBox[{"c3FQ3", "[", "ti", "]"}], "==", "c30"}]}], " ", "}"}], ",", 
      
