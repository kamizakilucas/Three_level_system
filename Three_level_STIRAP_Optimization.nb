Cell[CellGroupData[{

Cell["Optimal time-averaged excess work", "Section",
 CellChangeTimes->{{3.982670637070294*^9, 
  3.982670647616962*^9}},ExpressionUUID->"90e41138-d40a-4822-9698-\
f0037306e612"],

Cell["\<\
Apparently, the protocol found by optimizing the time-averaged excess work is \
equal to de fast quasidiabatic protocol. The protocols can be found by using \
the Euler-Lagrange equations on the excess work. The solutions are given \
below. \
\>", "Text",
 CellChangeTimes->{{3.983020980694742*^9, 
  3.983021054376514*^9}},ExpressionUUID->"6ce7bb18-d959-45da-83e6-\
2bca259e1187"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ProtOP", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox[
             RowBox[{"\[CapitalOmega]pOP", "[", "t", "]"}], "2"]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"3", " ", 
             SuperscriptBox[
              RowBox[{"\[CapitalOmega]pOP", "[", "t", "]"}], "2"]}], "+", 
            RowBox[{"3", " ", 
             SuperscriptBox[
              RowBox[{"\[CapitalOmega]pOP", "[", "t", "]"}], "4"]}], "+", 
            SuperscriptBox[
             RowBox[{"\[CapitalOmega]pOP", "[", "t", "]"}], "6"], "-", 
            RowBox[{"12", " ", 
             SuperscriptBox[
              RowBox[{
               SuperscriptBox["\[CapitalOmega]pOP", "\[Prime]",
                MultilineFunction->None], "[", "t", "]"}], "2"]}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "3"}], " ", 
             RowBox[{"\[CapitalOmega]pOP", "[", "t", "]"}], " ", 
             SuperscriptBox[
              RowBox[{
               SuperscriptBox["\[CapitalOmega]pOP", "\[Prime]",
                MultilineFunction->None], "[", "t", "]"}], "2"]}], "+", 
            RowBox[{
             SuperscriptBox["\[CapitalOmega]pOP", "\[Prime]\[Prime]",
              MultilineFunction->None], "[", "t", "]"}], "+", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"\[CapitalOmega]pOP", "[", "t", "]"}], "2"], " ", 
             RowBox[{
              SuperscriptBox["\[CapitalOmega]pOP", "\[Prime]\[Prime]",
               MultilineFunction->None], "[", "t", "]"}]}]}], ")"}]}], "\[Equal]",
          "0"}], ",", " ", 
        RowBox[{
         RowBox[{"\[CapitalOmega]pOP", "[", "ti", "]"}], "==", 
         "\[CapitalOmega]pi"}], ",", " ", 
        RowBox[{
         RowBox[{"\[CapitalOmega]pOP", "[", "tf", "]"}], "==", 
         "\[CapitalOmega]pf"}]}], "}"}], ",", 
      RowBox[{"\[CapitalOmega]pOP", "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "ti", ",", "tf"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"tf", ",", "Tmin", ",", "Tmax", ",", "\[CapitalDelta]T"}], 
     "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.982843452036036*^9, 3.982843456507213*^9}, {
  3.982845812337442*^9, 3.982845915402852*^9}},
 CellLabel->
  "In[105]:=",ExpressionUUID->"7369bbc0-39aa-47c0-9321-fa5ac801003d"],

