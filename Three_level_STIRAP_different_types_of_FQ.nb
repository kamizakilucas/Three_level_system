Cell[TextData[{
 "Data for the population transfer from the state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|1", "\[RightAngleBracket]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$|1 \\rangle$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0609cd07-3582-4c48-bed0-6ccb5236488a"],
 " to  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|3", "\[RightAngleBracket]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$|3 \\rangle$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "36a9db63-cf69-4d38-958e-b46aaaf68970"],
 " at the end of the protocol for protocols of different durations; the \
time-averaged excess work; and the cost of Santos and Sarandy for the fast \
quasidiabatic protocol. "
}], "Text",
 CellChangeTimes->{
  3.98301947077948*^9, {3.9830199140814*^9, 
   3.983019917989272*^9}},ExpressionUUID->"0b64846f-e9e4-4650-9f81-\
ed71a2e56413"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Population", " ", "transfer"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"pFQ1", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
