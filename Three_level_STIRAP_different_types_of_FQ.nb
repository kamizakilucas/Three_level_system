         RowBox[{
          RowBox[{"Directive", "[", " ", "11", "]"}], ",", " ", 
          RowBox[{"FontFamily", "->", " ", "\"\<Arial\>\""}], ",", " ", 
          "Black"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"LineLegend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<\!\(\*SubscriptBox[\(\[CapitalOmega]\), \
\(s\)]\)(t)\>\"", ",", "10"}], "]"}], "}"}], ",", 
            RowBox[{"LegendLayout", "\[Rule]", "\"\<Row\>\""}]}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"Left", ",", "0.78"}], "}"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"\[CapitalOmega]pFQ2", "[", "t", "]"}], "/.", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Part", "[", 
           RowBox[{"ProtFQ2", ",", " ", "n"}], "]"}], "]"}]}], "]"}], ",", 
