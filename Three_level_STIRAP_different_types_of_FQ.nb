                  RowBox[{"tf", "-", "Tmin"}], ")"}], "/", 
                 "\[CapitalDelta]T"}], " ", "+", " ", "1"}]}], "]"}], "]"}]}],
            "]"}], "*", 
          RowBox[{"c2FQ2", "[", "t", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", "*", "\[HBar]", "*", 
          RowBox[{
           RowBox[{"c2FQ2", "'"}], "[", "t", "]"}]}], " ", "==", 
