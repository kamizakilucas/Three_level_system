Cell[CellGroupData[{

Cell["Optimal time-averaged excess work", "Section",
 CellChangeTimes->{{3.982670637070294*^9, 
  3.982670647616962*^9}},ExpressionUUID->"90e41138-d40a-4822-9698-\
f0037306e612"],

Cell["\<\
Apparently, the protocol found by optimizing the time-averaged excess work is \
equal to de fast quasidiabatic protocol. The protocols can be found by using \
the Euler-Lagrange equations on the excess work. The solutions are given \
below. \
\>", "Text",
 CellChangeTimes->{{3.983020980694742*^9, 
  3.983021054376514*^9}},ExpressionUUID->"6ce7bb18-d959-45da-83e6-\
2bca259e1187"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ProtOP", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
