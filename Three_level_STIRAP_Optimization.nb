Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Fidelity", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"FLIN", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"c1", "[", "t", "]"}], "/.", 
           RowBox[{"Part", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{"Part", "[", 
               RowBox[{"Sol", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"tf", "-", "Tmin"}], ")"}], "/", 
                  "\[CapitalDelta]T"}], " ", "+", " ", "1"}]}], "]"}], "]"}], 
             ",", "1"}], "]"}]}], "/.", 
          RowBox[{"t", "->", "tf"}]}], ")"}], "*", "c1f"}], " ", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"c2", "[", "t", "]"}], "/.", 
           RowBox[{"Part", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{"Part", "[", 
               RowBox[{"Sol", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"tf", "-", "Tmin"}], ")"}], "/", 
                  "\[CapitalDelta]T"}], " ", "+", " ", "1"}]}], "]"}], "]"}], 
             ",", "2"}], "]"}]}], "/.", 
          RowBox[{"t", "->", "tf"}]}], ")"}], "*", "c2f"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"c3", "[", "t", "]"}], "/.", 
           RowBox[{"Part", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{"Part", "[", 
               RowBox[{"Sol", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"tf", "-", "Tmin"}], ")"}], "/", 
                  "\[CapitalDelta]T"}], " ", "+", " ", "1"}]}], "]"}], "]"}], 
             ",", "3"}], "]"}]}], "/.", 
          RowBox[{"t", "->", "tf"}]}], ")"}], "*", "c3f"}]}], "  ", "]"}], 
     " ", ",", 
     RowBox[{"{", 
      RowBox[{"tf", ",", "Tmin", ",", "Tmax", ",", "\[CapitalDelta]T"}], 
      "}"}]}], "]"}]}]}]], "Input",ExpressionUUID->"882c3335-73c5-41fc-a3f7-\
3ea73894d413"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Fast quasidiabatic", "Section",
 CellChangeTimes->{{3.982669101059161*^9, 
  3.9826691070983067`*^9}},ExpressionUUID->"0d24d13c-4924-400e-96b0-\
3c45e5770153"],

Cell["\<\
The protocols for the fast quasidiabatic method (FQ) can be found by solving \
the EDO generated when we make the adiabatic quantitative condition constant. \
\>", "Text",
 CellChangeTimes->{{3.983019173492551*^9, 
  3.983019241745723*^9}},ExpressionUUID->"66680b1e-07ce-44d0-a071-\
3b7e5b9f93c7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ProtFQ", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[CapitalOmega]pFQ", "'"}], "[", "t", "]"}], "/", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[CapitalOmega]pFQ", "[", "t", "]"}], "^", "2"}], 
                " ", "+", " ", 
                RowBox[{
                 RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "^", "2"}]}], 
               ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"3", "/", "2"}], ")"}]}]}], "*", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"1.5", "*", 
               RowBox[{"\[CapitalDelta]", "/", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"\[CapitalOmega]pFQ", "[", "t", "]"}], "^", "2"}],
                    " ", "+", " ", 
                   RowBox[{
                    RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "^", "2"}]}],
                   ")"}], "^", 
                 RowBox[{"(", 
                  RowBox[{"1", "/", "2"}], ")"}]}]}]}]}], ")"}]}], ",", "t"}],
           "]"}], " ", "==", "0"}], " ", ",", " ", 
        RowBox[{
         RowBox[{"\[CapitalOmega]pFQ", "[", "ti", "]"}], "==", 
         "\[CapitalOmega]pi"}], ",", " ", 
        RowBox[{
         RowBox[{"\[CapitalOmega]pFQ", "[", "tf", "]"}], "==", 
         "\[CapitalOmega]pf"}]}], "}"}], ",", "\[CapitalOmega]pFQ", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "ti", ",", "tf"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"tf", ",", "Tmin", ",", "Tmax", ",", "\[CapitalDelta]T"}], 
     "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"ProtFQ2", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[CapitalOmega]pFQ2", "'"}], "[", "t", "]"}], "/", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[CapitalOmega]pFQ2", "[", "t", "]"}], "^", "2"}], 
                " ", "+", " ", 
                RowBox[{
                 RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "^", "2"}]}], 
               ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"3", "/", "2"}], ")"}]}]}], "*", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"1.5", "*", 
               RowBox[{"\[CapitalDelta]", "/", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"\[CapitalOmega]pFQ2", "[", "t", "]"}], "^", 
                    "2"}], " ", "+", " ", 
                   RowBox[{
                    RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "^", "2"}]}],
                   ")"}], "^", 
                 RowBox[{"(", 
                  RowBox[{"1", "/", "2"}], ")"}]}]}]}]}], ")"}]}], ",", "t"}],
           "]"}], " ", "==", "0"}], " ", ",", " ", 
        RowBox[{
         RowBox[{"\[CapitalOmega]pFQ2", "[", "ti", "]"}], "==", 
         "\[CapitalOmega]pi"}], ",", " ", 
        RowBox[{
         RowBox[{"\[CapitalOmega]pFQ2", "[", "tf", "]"}], "==", 
         "\[CapitalOmega]pf"}]}], "}"}], ",", "\[CapitalOmega]pFQ2", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "ti", ",", "tf"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"tf", ",", "Tmin", ",", "Tmax", ",", "\[CapitalDelta]T"}], 
     "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"ProtFQ3", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalOmega]pFQ3", "[", "t", "]"}], "*", 
            RowBox[{
             RowBox[{
              RowBox[{"\[CapitalOmega]pFQ3", "'"}], "[", "t", "]"}], "/", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[CapitalOmega]pFQ3", "[", "t", "]"}], "^", "2"}], 
                " ", "+", " ", 
                RowBox[{
                 RowBox[{"\[CapitalOmega]s", "[", "t", "]"}], "^", "2"}]}], 
               ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"4", "/", "2"}], ")"}]}]}]}], ",", "t"}], "]"}], " ", "==",
          "0"}], " ", ",", " ", 
        RowBox[{
         RowBox[{"\[CapitalOmega]pFQ3", "[", "ti", "]"}], "==", 
         "\[CapitalOmega]pi"}], ",", " ", 
        RowBox[{
         RowBox[{"\[CapitalOmega]pFQ3", "[", "tf", "]"}], "==", 
         "\[CapitalOmega]pf"}]}], "}"}], ",", "\[CapitalOmega]pFQ3", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "ti", ",", "tf"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"tf", ",", "Tmin", ",", "Tmax", ",", "\[CapitalDelta]T"}], 
     "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.982669366399996*^9, 3.982669463935595*^9}, {
   3.983458769870409*^9, 3.983458792997546*^9}, {3.983459146584052*^9, 
   3.983459153969513*^9}, {3.983459221988677*^9, 3.9834592726800547`*^9}, 
   3.983459749134461*^9},
